# Copier ce fichier en "my.env" puis renseigner LLM_API_KEY.
# Lancement : ./run.sh   (ou: .venv/bin/ontocast --env-file my.env process ...)

CURRENT_DOMAIN=https://example.com

# --- Fournisseur LLM : décommenter UN des deux blocs -------------------------
# OpenAI
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-5.6-luna
# Anthropic
#LLM_PROVIDER=anthropic
#LLM_MODEL_NAME=claude-sonnet-5-5

LLM_API_KEY=remplace-moi
LLM_TEMPERATURE=0.0

# --- Coût réduit pour des essais ----------------------------------------------
LLM_MAX_INFLIGHT=4
PARALLEL_WORKERS=4
MAX_VISITS_PER_NODE=1
FACTS_CRITIC_PASSES=0

# ontology_and_facts (défaut) | ontology | facts
RENDER_MODE=ontology_and_facts
ONTOLOGY_CONTEXT_MODE=selected_single_ontology

# Cache local (réponses LLM) dans ce dossier
ONTOCAST_CACHE_DIR=./.cache

LOGGING_LEVEL=info
